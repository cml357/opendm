{
  "manifest_version": 2,
  "name": "OpenDM Firefox Integration",
  "version": "1.0.0",
  "description": "Renifleur vidéo et bouton flottant Télécharger cette vidéo pour OpenDM.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "opendm-extension@opendm.org"
    }
  }
}
