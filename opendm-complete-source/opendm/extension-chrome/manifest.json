{
  "manifest_version": 3,
  "name": "OpenDM Integration Module",
  "version": "1.0.0",
  "description": "Capture les téléchargements et détecte les flux vidéo pour OpenDM.",
  "permissions": [
    "declarativeNetRequest",
    "nativeMessaging",
    "activeTab",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
